#!/usr/bin/env bash
# maestro-check — the quality gate as commands, not sentences.
#
# Runs the checks of a gate level against the project in the cwd and prints ONE
# JSON verdict on stdout (human summary on stderr). Exit 0 = every check green
# or skipped-with-reason, exit 1 = at least one red. Every check is a real
# command with a real exit code; "the model judged it fine" is not a check.
#
#   maestro-check [--level off|standard|high|paranoid] [--scope staged|branch|all]
#                 [--json-only] [--list]
#
# Level comes from maestro_docs/gates.json when --level is absent (default
# standard). Scope limits path-based checks (rtl, boundaries, tests-related) to
# the staged diff (default), the branch (<default>...HEAD), or everything.
#
#   level     checks
#   off       secrets
#   standard  secrets · typecheck · lint · rtl · boundaries · tests (changed paths) · fonts
#   high      standard + full test suite · lighthouse (web, when configured)
#   paranoid  high + audit (dependency vulnerabilities)
#
# Stack is detected, never declared: pubspec.yaml → flutter; package.json with
# react-native/expo → expo; with next → next; otherwise node. A check whose tool
# is absent is "skipped" with the reason, never silently green — except
# `secrets`, which is never skippable (maestro-vcs ships it; without maestro-vcs
# the verdict says so in red).
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LEVEL=""; SCOPE="staged"; JSON_ONLY=0; LIST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --level) shift; LEVEL="${1:-}" ;;
    --scope) shift; SCOPE="${1:-staged}" ;;
    --json-only) JSON_ONLY=1 ;;
    --list) LIST=1 ;;
    -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac; shift
done
[ -n "$LEVEL" ] || LEVEL="$(node -e 'try{console.log(JSON.parse(require("fs").readFileSync("maestro_docs/gates.json","utf8")).level||"standard")}catch{console.log("standard")}' 2>/dev/null || echo standard)"
case "$LEVEL" in off|standard|high|paranoid) ;; *) echo "bad level: $LEVEL" >&2; exit 2 ;; esac

# ── stack & runner ──────────────────────────────────────────────────────────
STACK=node
if [ -f pubspec.yaml ]; then STACK=flutter
elif [ -f package.json ]; then
  if grep -qE '"(react-native|expo)"' package.json; then STACK=expo
  elif grep -q '"next"' package.json; then STACK=next; fi
fi
RUN=npm
if [ -f bun.lockb ] || [ -f bun.lock ]; then RUN=bun; elif [ -f pnpm-lock.yaml ]; then RUN=pnpm; elif [ -f yarn.lock ]; then RUN=yarn; fi
has_script() { [ -f package.json ] && node -e 'process.exit(((JSON.parse(require("fs").readFileSync("package.json","utf8")).scripts||{})[process.argv[1]])?0:1)' "$1" 2>/dev/null; }
run_script() { case "$RUN" in bun) bun run "$1" ;; pnpm) pnpm run "$1" ;; yarn) yarn "$1" ;; *) npm run "$1" ;; esac; }
# The base of a branch: origin/HEAD when a remote exists, else a local main or
# master that is not the current branch, else nothing. The first pilot had no
# remote and git's default 'master': the old 'main' guess made the branch
# scope EMPTY and every path check skipped with a plausible-looking reason.
CURRENT_BRANCH="$(git branch --show-current 2>/dev/null)"
BASE_REF=""
r="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"; [ -n "$r" ] && git rev-parse --verify -q "$r" >/dev/null && BASE_REF="$r"
if [ -z "$BASE_REF" ]; then for b in main master develop; do [ "$b" != "$CURRENT_BRANCH" ] && git rev-parse --verify -q "refs/heads/$b" >/dev/null && { BASE_REF="$b"; break; }; done; fi
SCOPE_NOTE=""
changed_files() {
  case "$SCOPE" in
    staged) git diff --cached --name-only --diff-filter=ACMR 2>/dev/null ;;
    branch)
      if [ -n "$BASE_REF" ]; then git diff --name-only --diff-filter=ACMR "$BASE_REF...HEAD" 2>/dev/null
      else SCOPE_NOTE="branch scope: no base branch found (no origin/HEAD, no local main/master other than $CURRENT_BRANCH) — fell back to --scope all"; git ls-files 2>/dev/null | grep -vE '(^|/)(node_modules|\.expo|\.next|dist|build)/'; fi ;;
    all) git ls-files 2>/dev/null | grep -vE '(^|/)(node_modules|\.expo|\.next|dist|build)/' ;;
  esac
}
CHANGED="$(changed_files)"
if [ "$SCOPE" = branch ] && [ -n "$BASE_REF" ] && [ -z "$CHANGED" ] && [ "$(git rev-list --count "$BASE_REF..HEAD" 2>/dev/null)" != 0 ]; then
  SCOPE_NOTE="branch scope: $BASE_REF...HEAD has commits but no changed file matched — check the base"
fi
AR_LOCALE=0
# (no `grep -q` on a git pipeline: under pipefail the early exit turns a hit into a failure — pilot bug)
if [ -n "$(ls messages/ar* locales/ar* 2>/dev/null)" ] || [ "$(git ls-files 2>/dev/null | grep -cE '(^|/)(ar\.json|ar-[a-z]+\.json|app_ar.*\.arb|intl_ar.*\.arb)$')" != 0 ]; then AR_LOCALE=1; fi

# ── result accumulation ─────────────────────────────────────────────────────
RESULTS=(); RED=0
record() { # name status(green|red|skipped) seconds command tail
  local name="$1" status="$2" secs="$3" cmd="$4" tail="$5"
  [ "$status" = red ] && RED=$((RED+1))
  RESULTS+=("$(node -e 'const [n,s,t,c,o]=process.argv.slice(1);console.log(JSON.stringify({name:n,status:s,seconds:+t,command:c,output:o}))' "$name" "$status" "$secs" "$cmd" "$tail")")
  if [ "$JSON_ONLY" = 0 ]; then
    case "$status" in green) echo "  ✅ $name  (${secs}s)" >&2 ;; red) echo "  ❌ $name  (${secs}s)  $cmd" >&2; printf '%s\n' "$tail" | sed 's/^/       /' >&2 ;; skipped) echo "  ⏭  $name — $tail" >&2 ;; esac
  fi
}
run_check() { # name command...
  local name="$1"; shift; local t0 rc out
  t0=$(date +%s); out="$("$@" 2>&1)"; rc=$?
  record "$name" "$([ $rc -eq 0 ] && echo green || echo red)" "$(( $(date +%s) - t0 ))" "$*" "$(printf '%s\n' "$out" | tail -25)"
}
skip() { record "$1" skipped 0 "" "$2"; }

want() { # is check $1 part of level $LEVEL ?
  case "$LEVEL:$1" in
    *:secrets) return 0 ;;
    off:*) return 1 ;;
    standard:typecheck|standard:lint|standard:rtl|standard:boundaries|standard:tests-related|standard:fonts) return 0 ;;
    high:tests-full|high:lighthouse) return 0 ;;
    paranoid:audit) return 0 ;;
    high:*|paranoid:*) case "$1" in typecheck|lint|rtl|boundaries|tests-related|fonts) return 0 ;; esac; [ "$LEVEL" = paranoid ] && case "$1" in tests-full|lighthouse) return 0 ;; esac; return 1 ;;
    *) return 1 ;;
  esac
}
if [ "$LIST" = 1 ]; then for c in secrets typecheck lint rtl boundaries tests-related fonts tests-full lighthouse audit; do want "$c" && echo "$c"; done; exit 0; fi

[ "$JSON_ONLY" = 0 ] && echo "maestro-check · level $LEVEL · stack $STACK · runner $RUN · scope $SCOPE ($(printf '%s\n' "$CHANGED" | grep -c .) file(s))$([ $AR_LOCALE = 1 ] && echo ' · ar locale')${BASE_REF:+ · base $BASE_REF}" >&2
[ -n "$SCOPE_NOTE" ] && [ "$JSON_ONLY" = 0 ] && echo "  ⚠ $SCOPE_NOTE" >&2

# ── secrets (never skippable) ───────────────────────────────────────────────
SCAN=""
for cand in "${CLAUDE_PLUGIN_ROOT:-}/../maestro-vcs/skills/00-commit/scripts/secret-scan.sh" "$HERE/../../maestro-vcs/skills/00-commit/scripts/secret-scan.sh"; do [ -f "$cand" ] && SCAN="$cand" && break; done
[ -z "$SCAN" ] && SCAN="$(ls -d "$HOME"/.claude/plugins/cache/*/maestro-vcs/*/skills/00-commit/scripts/secret-scan.sh 2>/dev/null | sort -V | tail -1)"
if [ -n "$SCAN" ] && [ -f "$SCAN" ]; then
  mode=cached; [ "$SCOPE" = branch ] && mode=branch; [ "$SCOPE" = all ] && mode=cached
  if [ "$mode" = branch ] && [ -n "$BASE_REF" ]; then out="$(bash "$SCAN" branch "$BASE_REF" 2>&1)"; else out="$(bash "$SCAN" $mode 2>&1)"; fi
  if printf '%s' "$out" | grep -q '^SECRET SCAN: RED'; then record secrets red 0 "secret-scan.sh $mode" "$out"
  elif printf '%s' "$out" | grep -q '^SECRET SCAN: skipped'; then record secrets red 0 "secret-scan.sh $mode" "$out (a scan that did not run is not clean)"
  else record secrets green 0 "secret-scan.sh $mode" "$(printf '%s' "$out" | head -1)"; fi
else
  record secrets red 0 "" "maestro-vcs not installed — the secrets scan did not run, and a scan that did not run is not clean"
fi

# ── typecheck ───────────────────────────────────────────────────────────────
if want typecheck; then
  case "$STACK" in
    flutter) command -v dart >/dev/null && run_check typecheck dart analyze --fatal-infos || skip typecheck "dart not on PATH" ;;
    *) if has_script typecheck; then run_check typecheck run_script typecheck
       elif [ -f tsconfig.json ] && [ -x node_modules/.bin/tsc ]; then run_check typecheck node_modules/.bin/tsc --noEmit -p tsconfig.json
       else skip typecheck "no typecheck script and no local tsc"; fi ;;
  esac
fi

# ── lint ────────────────────────────────────────────────────────────────────
if want lint; then
  case "$STACK" in
    flutter) skip lint "covered by dart analyze" ;;
    *) if has_script lint; then run_check lint run_script lint
       elif [ -x node_modules/.bin/eslint ]; then run_check lint node_modules/.bin/eslint . --max-warnings 0
       else skip lint "no lint script and no local eslint"; fi ;;
  esac
fi

# ── rtl (Arabic correctness, structural rules — only when an ar locale exists) ─
if want rtl; then
  if [ $AR_LOCALE = 1 ]; then
    FILES="$(printf '%s\n' "$CHANGED" | grep -E '\.(tsx?|jsx?|css|scss|dart)$' || true)"
    if [ -n "$FILES" ]; then run_check rtl node "$HERE/rtl-lint.js" $FILES
    else skip rtl "no UI file in scope"; fi
  else skip rtl "no ar locale (messages/ar*, ar.json, app_ar.arb)"; fi
fi

# ── boundaries (domain never imports infrastructure) ────────────────────────
if want boundaries; then
  if [ -f .dependency-cruiser.cjs ] || [ -f .dependency-cruiser.js ] || [ -f .dependency-cruiser.json ]; then
    if [ ! -x node_modules/.bin/depcruise ]; then skip boundaries "dependency-cruiser config present but not installed (npm i -D dependency-cruiser)"
    elif ls tsconfig*.json >/dev/null 2>&1 && [ ! -d node_modules/typescript ]; then skip boundaries "typescript not installed — dependency-cruiser cannot read .ts/.tsx without it (npm i -D typescript)"
    else
      DC_CFG=$(ls .dependency-cruiser.cjs .dependency-cruiser.js .dependency-cruiser.json 2>/dev/null | head -1)
      DIRS=""; for d in src app lib packages apps; do [ -d "$d" ] && DIRS="$DIRS $d"; done
      [ -n "$DIRS" ] || DIRS="."
      run_check boundaries node_modules/.bin/depcruise --config "$DC_CFG" $DIRS
      LAST="${RESULTS[${#RESULTS[@]}-1]}"
      if printf '%s' "$LAST" | grep -q '"status":"green"' && printf '%s' "$LAST" | grep -q '(0 modules'; then
        unset 'RESULTS[${#RESULTS[@]}-1]'; record boundaries red 0 "depcruise --config $DC_CFG $DIRS" "0 modules cruised — the config matched nothing (wrong folders, or a transpiler missing: depcruise --info); a boundary that checks nothing is not green"
      fi
    fi
  elif [ "$STACK" = flutter ] && grep -q 'dart_code_metrics\|import_lint' pubspec.yaml 2>/dev/null; then run_check boundaries dart run import_lint
  else skip boundaries "no .dependency-cruiser.cjs — run maestro-core:00-onboard scaffold (architecture) to get one"; fi
fi

# ── tests ───────────────────────────────────────────────────────────────────
if want tests-related || want tests-full; then
  case "$STACK" in
    flutter)
      if [ -d test ]; then run_check "tests-$( want tests-full && echo full || echo related)" flutter test; else skip tests-related "no test/ directory"; fi ;;
    *)
      if has_script test; then
        if want tests-full; then run_check tests-full run_script test
        else
          REL="$(printf '%s\n' "$CHANGED" | grep -E '\.(tsx?|jsx?)$' | grep -vE '\.(test|spec)\.' || true)"
          if [ -z "$REL" ]; then skip tests-related "no source file in scope"
          elif [ -x node_modules/.bin/jest ]; then run_check tests-related node_modules/.bin/jest --findRelatedTests --passWithNoTests $REL
          elif [ -x node_modules/.bin/vitest ]; then run_check tests-related node_modules/.bin/vitest related --run --passWithNoTests $REL
          else run_check tests-related run_script test; fi   # no related-tests runner: the whole script, named as such in the output
        fi
      else skip tests-related "no test script in package.json — a project with none has no gate against regressions"; fi ;;
  esac
fi

# ── fonts (Arabic metrics, mobile only) ─────────────────────────────────────
if want fonts; then
  if [ $AR_LOCALE = 1 ] && { [ "$STACK" = expo ] || [ "$STACK" = flutter ]; }; then
    FM=""
    for cand in "${CLAUDE_PLUGIN_ROOT:-}/../maestro-mobile/skills/01-rtl-i18n/assets/font-metrics.py" "$HERE/../../maestro-mobile/skills/01-rtl-i18n/assets/font-metrics.py"; do [ -f "$cand" ] && FM="$cand" && break; done
    [ -z "$FM" ] && FM="$(ls -d "$HOME"/.claude/plugins/cache/*/maestro-mobile/*/skills/01-rtl-i18n/assets/font-metrics.py 2>/dev/null | sort -V | tail -1)"
    FONTS="$(git ls-files 2>/dev/null | grep -iE '\.(ttf|otf)$' | grep -viE 'node_modules' || true)"
    if [ -z "$FM" ]; then skip fonts "maestro-mobile not installed"
    elif [ -z "$FONTS" ]; then skip fonts "no .ttf/.otf tracked — fonts loaded from a package are checked at install (see 01-rtl-i18n)"
    elif ! python3 -c 'import fontTools' 2>/dev/null; then skip fonts "python fontTools missing (pip install fonttools)"
    else run_check fonts python3 -I "$FM" check $FONTS; fi
  else skip fonts "web stack or no ar locale"; fi
fi

# ── lighthouse (web, high+) ─────────────────────────────────────────────────
if want lighthouse; then
  if [ "$STACK" = next ] || [ "$STACK" = node ]; then
    if [ -f lighthouserc.js ] || [ -f lighthouserc.json ] || [ -f .lighthouserc.js ] || [ -f .lighthouserc.json ]; then
      if [ -x node_modules/.bin/lhci ]; then run_check lighthouse node_modules/.bin/lhci autorun; else skip lighthouse "lighthouserc present, @lhci/cli not installed"; fi
    else skip lighthouse "no lighthouserc.* — 02-perf-audit scaffolds one with the Maestro thresholds (LCP ≤ 2.5 s, a11y ≥ 95)"; fi
  else skip lighthouse "not a web stack"; fi
fi

# ── audit (paranoid) ────────────────────────────────────────────────────────
if want audit; then
  case "$STACK" in
    flutter) run_check audit dart pub outdated --no-dev-dependencies ;;
    *) case "$RUN" in pnpm) run_check audit pnpm audit --audit-level high ;; yarn) run_check audit yarn npm audit --severity high ;; bun) run_check audit bun audit ;; *) run_check audit npm audit --audit-level high ;; esac ;;
  esac
fi

# ── verdict ─────────────────────────────────────────────────────────────────
VERDICT=$([ $RED -eq 0 ] && echo green || echo red)
node -e '
const [level,stack,scope,verdict,ar,base,note]=process.argv.slice(1,8); const checks=process.argv.slice(8).map(JSON.parse);
console.log(JSON.stringify({tool:"maestro-check",level,stack,scope,base:base||null,scope_note:note||null,ar_locale:ar==="1",verdict,red:checks.filter(c=>c.status==="red").length,green:checks.filter(c=>c.status==="green").length,skipped:checks.filter(c=>c.status==="skipped").length,checks},null,2));
' "$LEVEL" "$STACK" "$SCOPE" "$VERDICT" "$AR_LOCALE" "$BASE_REF" "$SCOPE_NOTE" "${RESULTS[@]}"
[ "$JSON_ONLY" = 0 ] && echo "maestro-check: $VERDICT ($RED red)" >&2
[ $RED -eq 0 ]
