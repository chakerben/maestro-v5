#!/usr/bin/env bash
# Shim for contributors working in this checkout: the tool lives in the plugin
# (plugins/maestro-vcs/bin/gwt — on the Bash PATH wherever maestro-vcs is
# enabled, so a project never needs this file). Kept so `scripts/gwt` and the
# ~/.local/bin link install-shortcuts.sh used to plant keep working.
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/plugins/maestro-vcs/bin/gwt" "$@"
